OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/auto
# Set your OpenRouter API key here; keep the real key only in the ignored .env file.
OPENAI_API_KEY=
# Model behavior settings, independent of the API endpoint.
# Reasoning effort: none, minimal, low, medium, high, xhigh, or max.
MODEL_REASONING_EFFORT=low
# Initial output-token limit; truncated responses retry with a doubled limit.
MODEL_MAX_OUTPUT_TOKENS=16384
# OpenRouter Auto chooses the context window of its selected model; it cannot be set here.
# Optional: YouTube Data API v3 key; empty uses anonymous public YouTube pages.
GOOGLE_YT_DATA_API_KEY=

# Alternative: use local Ollama instead of OpenRouter.
# Uncomment these and comment out the OpenRouter OPENAI_BASE_URL and OPENAI_MODEL above.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3:14b
# Local Ollama does not require an API key.
# OPENAI_API_KEY=
# qwen3:14b supports disabling thinking; Ollama receives think=false.
# These model settings replace the OpenRouter values above when using Ollama.
# MODEL_REASONING_EFFORT=none
# MODEL_CONTEXT_TOKENS=32768
# MODEL_MAX_OUTPUT_TOKENS=4096
